---
import SvgFilters from "#/components/filters/SvgFilters.astro";
import "#/styles/global.css";
import "#/styles/themes/index.css";
import { resolveTheme } from "#/styles/themes/registry";
import { CookieConsentBanner } from "@/components/CookieConsentBanner";

type Props = {
  title: string | null;
  bodyClass?: string;
  /** Raw `rooms.theme`; unregistered or absent values resolve to the default. */
  theme?: string | null;
};

const { title, bodyClass = "", theme } = Astro.props;

/*
The theme is always known server-side, so both attributes are rendered into the
markup rather than set by a pre-paint script — no script, no flash. A script
comes back only once something client-only feeds in (a stored user preference,
`prefers-color-scheme`).

`data-theme` drives daisyUI and the theme stylesheets; `data-theme-polarity`
drives the `dark:` variant, so registering a dark theme needs no edit to
global.css.
*/
const { name: themeName, polarity } = resolveTheme(theme);
---

<html
  lang="en"
  class="h-full"
  data-theme={themeName}
  data-theme-polarity={polarity}
>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{`${title ?? ""}${title ? " | " : ""}Chat with Dice`}</title>
  </head>
  <body class={"flex h-full w-full flex-col overflow-auto " + bodyClass}>
    <SvgFilters />
    <slot />
    <CookieConsentBanner client:only />
  </body>
</html>
