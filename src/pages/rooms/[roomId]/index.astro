---
import { db } from "#/db";
import HTML from "#/layouts/HTML.astro";
import { resolveTheme } from "#/styles/themes/registry";
import { logger } from "#/utils/logger";
import { roomConfigValidator } from "#/validators/roomConfigValidator";
import { defaultRoomConfig } from "#/workers/ChatRoomDO/defaultRoomConfig";
import { DiceRoller } from "@/components/DiceRoller/DiceRoller";

export const prerender = false;
const roomId = Astro.params["roomId"] ?? "";
const room = await db.query.rooms.findFirst({
  where: {
    id: roomId,
  },
});

if (!room) {
  return Astro.redirect("/rooms");
}

const configParseResult = roomConfigValidator.safeParse(room.config);
const config = configParseResult.success
  ? configParseResult.data
  : defaultRoomConfig;
if (configParseResult.success === false) {
  logger.error("Room failed config validation");
}

// Resolved once and handed to both consumers, so the markup and the island
// can't disagree about which theme this room is in.
const theme = resolveTheme(room.theme);
---

<HTML title={room?.name ?? "(room not found)"} theme={theme.name}>
  <DiceRoller
    client:only
    roomId={roomId ?? ""}
    config={config}
    displayName={room.name}
    roomOwnerId={room.createdByUserId}
    theme={theme.name}
  />
</HTML>
